{
  "name": "ci-runner-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first GitHub Actions inspection and trusted npm-script measurements",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node src/cli.js demo --no-open",
    "lint": "eslint src tests *.js",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "open": "11.0.4",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
